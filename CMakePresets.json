{
  "version": 4,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "${presetName} Preset",
      "description": "Preset to use with ${presetName}",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
